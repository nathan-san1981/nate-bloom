declare name "Nylon Guitar";
declare description "A physical model of a classical guitar string and body; pluck it near the bridge for bite or near the middle for warmth";
import("stdfaust.lib");
freq = hslider("freq", 440, 20, 8000, 0.01);
gain = hslider("gain", 0.8, 0, 1, 0.01);
gate = button("gate");
pluck = hslider("[0]Pluck position [unit:%]", 80, 5, 95, 1) / 100 : si.smoo;
tone  = hslider("[1]Tone [unit:Hz][scale:log]", 7000, 800, 18000, 1) : si.smoo;
level = hslider("[2]Level [unit:%]", 80, 0, 100, 1) / 100 : si.smoo;
process = pm.nylonGuitar(freq : pm.f2l, pluck, gain, gate) : fi.lowpass(2, tone) : *(level * 4);
