declare name "Tape Echo";
declare description "A tape delay: repeats that darken, saturate and wobble, ping-ponging across the stereo field, and a feedback that can run away into self-oscillation";
import("stdfaust.lib");
time  = hslider("[0]Time [unit:ms]", 380, 40, 1500, 1) : si.smooth(0.9995);
fb    = hslider("[1]Feedback [unit:%]", 48, 0, 115, 1) / 100 : si.smoo;
wow   = hslider("[2]Wow & flutter [unit:%]", 35, 0, 100, 1) / 100 : si.smoo;
tone  = hslider("[3]Tone [unit:Hz][scale:log]", 3200, 500, 12000, 1) : si.smoo;
drive = hslider("[4]Saturation [unit:%]", 35, 0, 100, 1) / 100 : si.smoo;
pp    = hslider("[5]Ping-pong [unit:%]", 60, 0, 100, 1) / 100 : si.smoo;
mix   = hslider("[6]Mix [unit:%]", 30, 0, 100, 1) / 100 : si.smoo;
MAXD = 131072;
wob(ph) = wow * (0.0022 * os.oscp(0.47, ph) + 0.00055 * os.oscp(6.1, ph * 2) + 0.0004 * no.lfnoise(2.3));
dl(ph) = max(64, (time / 1000 + wob(ph)) * ma.SR);
k = 1 + drive * 5;
sat(x) = ma.tanh(k * x) / k * (1 + drive * 0.6);
line(ph, x) = x : de.fdelay(MAXD, dl(ph)) : fi.lowpass(2, tone) : fi.highpass(1, 110) : sat;
echo(m) = (\(a, b).(line(0, m + b * fb), line(1.3, a * fb))) ~ (_, _);
wet(l, r) = echo((l + r) * 0.5) : spread with { spread(a, b) = a + b * (1 - pp), b + a * (1 - pp); };
process = _, _ <: (_, _), wet : ro.interleave(2, 2) : par(i, 2, xf) with { xf(d, w) = d * (1 - mix * 0.5) + w * mix; };
