{"id": "twist", "build": 2, "port": true, "name": "Twist", "vendor": "Nate Bloom", "identifier": "com.natebloom.twist", "kind": "instrument", "type": "Macro oscillator", "description": "Mutable Instruments' Plaits (\u00c9milie Gillet, MIT) as a whole eight-voice synth: 24 models (analog, phase distortion, three banks of 6-op FM, wave terrain, string machine, chiptune, wavetable, chords, speech, swarm, noise, particles, plucked string, bells, drums) under Harmonics \u00b7 Timbre \u00b7 Morph, Plaits' low-pass gate, then a resonant filter with its own envelope, an LFO, the Juno-60 chorus (KR-106) and Airwindows Galactic3 reverb.", "blurb": "Plaits' 24 models under Harmonics, Timbre, Morph, now a whole synth: a resonant filter with its own envelope, an LFO for pitch, timbre, morph and cutoff, the Juno chorus and Galactic reverb.", "params": [{"id": "model", "index": 0, "label": "Model", "short": "MODEL", "group": "Oscillator", "min": 0, "max": 23, "init": 8, "step": 1, "menu": [["VA with filter", 0], ["Phase distortion", 1], ["6-op FM \u00b7 bank A", 2], ["6-op FM \u00b7 bank B", 3], ["6-op FM \u00b7 bank C", 4], ["Wave terrain", 5], ["String machine", 6], ["Chiptune", 7], ["Virtual analog", 8], ["Waveshaper", 9], ["2-op FM", 10], ["Formant / grain", 11], ["Harmonic (additive)", 12], ["Wavetable", 13], ["Chords", 14], ["Speech", 15], ["Swarm", 16], ["Filtered noise", 17], ["Particles", 18], ["Plucked string", 19], ["Modal / bells", 20], ["Bass drum", 21], ["Snare", 22], ["Hi-hat", 23]]}, {"id": "harmonics", "index": 1, "label": "Harmonics", "short": "HARM", "group": "Oscillator", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "timbre", "index": 2, "label": "Timbre", "short": "TIMBRE", "group": "Oscillator", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "morph", "index": 3, "label": "Morph", "short": "MORPH", "group": "Oscillator", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "decay", "index": 4, "label": "Decay", "short": "DECAY", "group": "Low-pass gate", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "colour", "index": 5, "label": "Colour", "short": "COLOUR", "group": "Low-pass gate", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "attack", "index": 6, "label": "Attack", "short": "ATT", "group": "Envelope", "min": 0, "max": 1, "init": 0.0, "disp": {"f": "exp", "a": 0.002, "b": 1000, "u": "s"}}, {"id": "release", "index": 7, "label": "Release", "short": "REL", "group": "Envelope", "min": 0, "max": 1, "init": 0.5, "disp": {"f": "exp", "a": 0.01, "b": 600, "u": "s"}}, {"id": "spread", "index": 8, "label": "Spread", "short": "SPREAD", "group": "Output", "min": 0, "max": 1, "init": 0.3, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "level", "index": 9, "label": "Level", "short": "LEVEL", "group": "Output", "min": 0, "max": 1, "init": 0.8, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "fm_amount", "index": 10, "label": "Env \u2192 Pitch", "short": "ENV>PIT", "group": "Envelope", "min": -1, "max": 1, "init": 0, "disp": {"f": "lin", "a": -100, "b": 100, "d": 0}}, {"id": "timbre_mod", "index": 11, "label": "Env \u2192 Timbre", "short": "ENV>TIM", "group": "Envelope", "min": -1, "max": 1, "init": 0, "disp": {"f": "lin", "a": -100, "b": 100, "d": 0}}, {"id": "morph_mod", "index": 12, "label": "Env \u2192 Morph", "short": "ENV>MOR", "group": "Envelope", "min": -1, "max": 1, "init": 0, "disp": {"f": "lin", "a": -100, "b": 100, "d": 0}}, {"id": "cutoff", "index": 13, "label": "Cutoff", "short": "CUTOFF", "group": "Filter", "min": 0, "max": 1, "init": 1.0, "disp": {"f": "exp", "a": 20, "b": 20000, "u": "Hz", "d": 0}}, {"id": "resonance", "index": 14, "label": "Resonance", "short": "RES", "group": "Filter", "min": 0, "max": 1, "init": 0, "disp": {"f": "lin", "a": 0, "b": 100, "d": 0}}, {"id": "filter_env", "index":