{"id": "glitch_starter", "build": 2, "port": true, "name": "Glitch Starter", "vendor": "Nathan", "identifier": "com.nathan.glitch_starter", "kind": "effect", "type": "Glitch", "description": "A tempo-synced random glitch: stutter, reverse, tape stop, bitcrush and gate, picked by weight on each step while the sequencer plays. Click-free: stutter repeats crossfade, the gate ramps, the tape stop is a varispeed that slows like a motor and goes dull as it slows.", "blurb": "Random glitches on 1/8, 1/16 or 1/32 steps while the transport runs; weights set how often each kind happens.", "params": [{"id": "prob", "label": "Probability", "min": 0, "max": 1, "init": 0.35, "index": 0, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "div", "label": "Division", "min": 0, "max": 2, "init": 1, "step": 1, "menu": [["1/8", 0], ["1/16", 1], ["1/32", 2]], "index": 1}, {"id": "mix", "label": "Mix", "min": 0, "max": 1, "init": 1, "index": 2, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "bits", "label": "Crush Bits", "min": 2, "max": 16, "init": 6, "step": 1, "index": 3}, {"id": "pitch", "label": "Pitch Jump", "min": 0, "max": 1, "init": 0.25, "index": 4, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "w_stut", "label": "Stutter Weight", "min": 0, "max": 1, "init": 1, "index": 5, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "w_rev", "label": "Reverse Weight", "min": 0, "max": 1, "init": 0.6, "index": 6, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "w_tape", "label": "Tape Stop Weight", "min": 0, "max": 1, "init": 0.3, "index": 7, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "w_crush", "label": "Crush Weight", "min": 0, "max": 1, "init": 0.5, "index": 8, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}, {"id": "w_gate", "label": "Gate Weight", "min": 0, "max": 1, "init": 0.5, "index": 9, "disp": {"f": "lin", "a": 0, "b": 100, "u": "%", "d": 0}}], "presets": [{"name": "Default", "values": {"prob": 0.35, "div": 1, "mix": 1, "bits": 6, "pitch": 0.25, "w_stut": 1, "w_rev": 0.6, "w_tape": 0.3, "w_crush": 0.5, "w_gate": 0.5}}, {"name": "Stutter only", "values": {"prob": 0.4, "div": 1, "mix": 1, "bits": 16, "pitch": 0, "w_stut": 1, "w_rev": 0, "w_tape": 0, "w_crush": 0, "w_gate": 0}}, {"name": "Reverse swells", "values": {"prob": 0.3, "div": 2, "mix": 1, "bits": 16, "pitch": 0, "w_stut": 0.2, "w_rev": 1, "w_tape": 0, "w_crush": 0, "w_gate": 0}}, {"name": "Tape stops", "values": {"prob": 0.25, "div": 2, "mix": 1, "bits": 16, "pitch": 0, "w_stut": 0, "w_rev": 0.2, "w_tape": 1, "w_crush": 0, "w_gate": 0}}, {"name": "Bitcrush chaos", "values": {"prob": 0.6, "div": 0, "mix": 1, "bits": 4, "pitch": 0.5, "w_stut": 0.5, "w_rev": 0.3, "w_tape": 0.2, "w_crush": 1, "w_gate": 0.4}}, {"name": "Gate chop", "values": {"prob": 0.5, "div": 0, "mix": 1, "bits": 16, "pitch": 0, "w_stut": 0.2, "w_rev": 0, "w_tape": 0, "w_crush": 0, "w_gate": 1}}, {"name": "Subtle sprinkle", "values": {"prob": 0.12, "div": 1, "mix": 0.7, "bits": 8, "pitch": 0.15, "w_stut": 1, "w_rev": 0.5, "w_tape": 0.2, "w_crush": 0.3, "w_gate": 0.3}}, {"name": "IDM storm", "values": {"prob": 0.8, "div": 0, "mix": 1, "bits": 5, "pitch": 0.7, "w_stut": 1, "w_rev": 0.7, "w_tape": 0.5, "w_crush": 0.7, "w_gate": 0.7}}]}