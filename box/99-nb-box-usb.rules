# Nate Bloom Box: a USB stick's partition (or a stick with no partition table) is mounted read-only for the DJ
# (nb-box-usb@.service runs nb-box-helper usb-mount / usb-unmount; pulling the stick stops the service).
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", TAG+="systemd", ENV{SYSTEMD_WANTS}+="nb-box-usb@%k.service"
