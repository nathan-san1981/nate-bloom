[Unit]
Description=Nate Bloom Box: CPU speed that follows the load (the app asks for full speed for music and games; CPU=full in nb-box.conf keeps it fast)
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nb-box-helper cpu-save

[Install]
WantedBy=multi-user.target
